+bool tryParseHexUint64(std::string_view text, uint64_t& value) {
+	if (text.empty()) {
+		return false;
+	}
+	std::string owned(text);
+	char* end = nullptr;
+	errno = 0;
+	const auto parsed = std::strtoull(owned.c_str(), &end, 0);
+	if (errno != 0 || end == owned.c_str() || *end != '\0') {
